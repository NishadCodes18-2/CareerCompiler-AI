# ==============================================================================
# CareerCompiler AI — Production Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Get your free serverless Postgres connection string at https://console.neon.tech
# It should look like: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-YOUR-PROJECT.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate any secure random string (e.g. openssl rand -hex 32)
SECRET_KEY=careercompiler-ai-super-secret-key-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. EXTERNAL AI & INTEGRATION KEYS (Optional)
# ------------------------------------------------------------------------------
# For enhanced AI analysis, job parsing and evidence verification
OPENAI_API_KEY=
# For higher rate-limits on GitHub profile & repo extraction (Optional)
GITHUB_TOKEN=
# For live job market search (Optional)
SEARCH_API_KEY=

# ------------------------------------------------------------------------------
# 4. STORAGE & PROJECT METADATA
# ------------------------------------------------------------------------------
PROJECT_NAME="CareerCompiler AI"
TAGLINE="Compile your career into proof."
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
STORAGE_DIR="./storage"
